# 复制本文件为 .env 并填写真实值（.env 不应提交到 Git）

# ============== Pie Gateway 配置（可选，仅用于 LLM Provider） ==============
# 配置后自动使用 Pie Gateway 作为 LLM Provider（与网页搜索无关）
# 也可从项目根目录的 .pieconfig/env 自动读取
PIE_APP_ID=
PIE_APP_SECRET=
PIE_GATEWAY_PATH=

# ============== OpenAI 兼容服务配置（备选） ==============
# 未配置 Pie Gateway 时回退使用此配置
API_KEY=
BASE_URL=https://api.openai.com/v1

# 模型 ID（填写你使用的服务端支持的模型名）
MODEL=

# 可选：Mini-Code 引擎日志级别
# minimal | normal | verbose （也可用 0 | 1 | 2）
LM_LOG_LEVEL=normal

# 可选：开启调试日志（会在当前工作目录写入 lm_debug.log，可能包含敏感信息）
# 为空表示关闭；任意非空值表示开启
LM_DEBUG=

# 可选：最大工具调用轮次限制（默认 50，设为 0 表示无限制）
# 复杂任务可能需要更多轮次，可根据需要调整
LM_MAX_TURNS=50

# 可选：LLM 请求遇到限流（429）、服务端 5xx 或连接错误时的最大重试次数（默认 3，设为 0 关闭）
# 指数退避约 1s → 2s → 4s；流式响应开始输出后出错不会重试，避免内容重复
LM_MAX_RETRIES=

# 可选：覆盖 Exa 免费搜索端点（默认 https://mcp.exa.ai/mcp，无需 API key）
EXA_MCP_URL=

# ============== 安全策略 ==============

# 可选：run_shell 命令执行超时（秒，默认 120）
# 超时后命令会被强制终止，防止长驻命令卡死会话
LM_SHELL_TIMEOUT=120

# 可选：run_shell 严格模式。设为 1 时只允许白名单命令
# （git / go / npm / 测试 / 只读命令等），其余一律拒绝。
# 未设置时仅拦截黑名单中的不可逆命令（rm -rf /、mkfs、格式化磁盘等）。
# 注意：无论是否开启，run_shell 都能访问工作区之外的文件，
# 它不是沙箱，仅用于防止误操作。
LM_SHELL_STRICT=

# 可选：上下文 token 预算（默认 96000）。
# 超出预算时会自动压缩历史：把较早的对话交给模型生成摘要，
# 只保留系统提示 + 最近 12 条原文。
# 设为较小值可提前触发压缩，便于观察行为。
LM_CONTEXT_BUDGET=

# ============== 沙箱 ==============

# 可选：严格沙箱模式。设为 1 时，操作系统级沙箱不可用将直接拒绝执行
# run_shell 命令，而不是降级为无沙箱运行。
# ⚠️ Windows 上会拒绝所有 run_shell 命令（该平台无可行的 OS 文件沙箱）。
LM_SANDBOX_STRICT=

# 可选：设为 0 显式关闭 OS 级沙箱（逃生舱）。
# 仅当某平台沙箱策略过严、正常构建被误拒时使用；启动时会打印醒目提示。
LM_SANDBOX=

# 可选：额外允许沙箱读写的目录（逗号分隔），如构建缓存位置。
# 默认自动取 GOCACHE / GOMODCACHE / TMPDIR 等环境变量。
LM_SANDBOX_WRITABLE=

# 所有 run_shell 执行都会追加记录到 <工作区>/.mini-code/audit.log（JSONL 格式），
# 包含命令、工作目录、是否被策略拦截、退出码与 PID，用于事后追溯。

