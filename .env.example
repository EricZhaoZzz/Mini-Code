# 复制本文件为 .env 并填写真实值（.env 不应提交到 Git）

# ============== Pie Gateway 配置（可选，仅用于 LLM Provider） ==============
# 配置后自动使用 Pie Gateway 作为 LLM Provider（与网页搜索无关）
# 也可从项目根目录的 .pieconfig/env 自动读取
PIE_APP_ID=
PIE_APP_SECRET=
PIE_GATEWAY_PATH=

# ============== OpenAI 兼容服务配置（备选） ==============
# 未配置 Pie Gateway 时回退使用此配置
API_KEY=
BASE_URL=https://api.openai.com/v1

# 模型 ID（填写你使用的服务端支持的模型名）
MODEL=

# 可选：Mini-Code 引擎日志级别
# minimal | normal | verbose （也可用 0 | 1 | 2）
LM_LOG_LEVEL=normal

# 可选：开启调试日志（会在当前工作目录写入 lm_debug.log，可能包含敏感信息）
# 为空表示关闭；任意非空值表示开启
LM_DEBUG=

# 可选：最大工具调用轮次限制（默认 50，设为 0 表示无限制）
# 复杂任务可能需要更多轮次，可根据需要调整
LM_MAX_TURNS=50

# 可选：覆盖 Exa 免费搜索端点（默认 https://mcp.exa.ai/mcp，无需 API key）
EXA_MCP_URL=

# ============== 安全策略 ==============

# 可选：run_shell 命令执行超时（秒，默认 120）
# 超时后命令会被强制终止，防止长驻命令卡死会话
LM_SHELL_TIMEOUT=120

# 可选：run_shell 严格模式。设为 1 时只允许白名单命令
# （git / go / npm / 测试 / 只读命令等），其余一律拒绝。
# 未设置时仅拦截黑名单中的不可逆命令（rm -rf /、mkfs、格式化磁盘等）。
# 注意：无论是否开启，run_shell 都能访问工作区之外的文件，
# 它不是沙箱，仅用于防止误操作。
LM_SHELL_STRICT=

# 可选：上下文 token 预算（默认 96000）。
# 超出预算时会自动压缩历史：把较早的对话交给模型生成摘要，
# 只保留系统提示 + 最近 12 条原文。
# 设为较小值可提前触发压缩，便于观察行为。
LM_CONTEXT_BUDGET=

